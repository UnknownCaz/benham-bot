<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  The Benham face on cazzy-mac (Phase B, INTENT decisions 38-48). Codex's plist
  shape (com.caz.codex-bot), with three deliberate differences:

    * NO face marker and NO BENHAM_FACE: the primary face is MARKERLESS
      (INTENT Stage 7 - state_for(benham) IS state/, so the copied stores are
      visible). A marker here would be the misdelivery the design refuses.
    * BENHAM_API_BIND: the second listener, on the tailnet INTERFACE address
      (never 0.0.0.0), same port number as health on a second socket.
    * BENHAM_HOST_NAME: only for the words `benham.py status` prints.

  Install: sudo cp scripts/mac/com.caz.benham-bot.plist /Library/LaunchDaemons/
           sudo chown root:wheel /Library/LaunchDaemons/com.caz.benham-bot.plist
           sudo launchctl bootstrap system /Library/LaunchDaemons/com.caz.benham-bot.plist
  Restart: sudo launchctl kickstart -k system/com.caz.benham-bot
  Stop:    sudo launchctl bootout system/com.caz.benham-bot
-->
<dict>
  <key>Label</key><string>com.caz.benham-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/administrator/benham-bot/.venv/bin/python</string>
    <string>-u</string>
    <string>-m</string>
    <string>benham.bot</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/administrator/benham-bot</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BENHAM_HEALTH_PORT</key><string>8903</string>
    <key>BENHAM_API_BIND</key><string>100.76.11.56</string>
    <key>BENHAM_API_PORT</key><string>8903</string>
    <key>BENHAM_API_TOKEN_FILE</key><string>/Users/administrator/.config/benham-bot.token</string>
    <key>BENHAM_HOST_NAME</key><string>cazzy-mac</string>
    <key>BENHAM_LOG_FILE</key><string>/Users/administrator/benham-bot/logs/benham.log</string>
    <key>EXAROTON_SKILL_DIR</key><string>/Users/administrator/benham-bot/vendor/exaroton</string>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>UserName</key><string>administrator</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>/Users/administrator/benham-bot/logs/launchd-benham.log</string>
  <key>StandardErrorPath</key><string>/Users/administrator/benham-bot/logs/launchd-benham.err</string>
</dict>
</plist>
