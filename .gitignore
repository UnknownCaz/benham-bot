*.env
webhooks.json
outbox/
channels.json
# Runtime transcripts and message logs. Catch-all rather than a per-file list, so
# a new *.jsonl cannot be committed by accident.
*.jsonl
bot.log
__pycache__/
*.pyc
venv-voice/
personality_overrides.txt
*.log
exaroton_watch.json
# Control plane: owner user ids + guild allowlists. Real IDs stay local; the
# committed control.json.example documents the shape.
control.json
# Phase B client config: where the bot runs and which token file to carry.
# The committed remote.json.example documents the shape.
remote.json
# Agent conversation history — private message content.
agent_memory.json
# Guest conversations and their daily counters. Other people's message content and
# a record of who talked to Benham and how much; never commit either.
guest_memory.json
guest_usage.json

# Friend-server reads / derived social data — private, never commit
read_full*
*.u8
*.tsv
stats.tsv
# Bot stdout/stderr captures from Start-Process redirects (*.log is already covered,
# but the redirect targets do not always end in .log).
*.out
*.err
# Rotated-out captures. The patterns above already match inside it; this is here so
# the intent is obvious and nothing else in logs/ can sneak into a commit.
logs/
# Rotation writes `<name>.1`, which the extension patterns above do NOT match -
# "supervise.log.1" is not *.log and "inbox.jsonl.1" is not *.jsonl. Without these
# two lines the previous generation of every rotated file becomes committable, which
# is how private message content would reach the repo by the back door.
*.log.1
*.jsonl.1
# Attachments pulled off Discord by read_attachments. Other people's files, and
# bytes whoever uploaded them chose - neither belongs in the repo.
downloads/
# Throwaway diagnostic output from debugging sessions.
diag*.txt
d[0-9].txt
m[0-9].txt

# Guest workspace (guest-refactor Stage 4) - guests' files, never committed
guest_work/

# Manual backup of inbox.jsonl - same private message content as the original;
# .bak defeats both the *.jsonl and *.jsonl.1 patterns above.
*.jsonl.bak
# Task Scheduler exports embed the machine SID and account name - keep local.
*.task.backup.xml
# Claude session-local settings and worktrees.
.claude/

# Bot-written voice defaults (was mistakenly tracked until the src reorg;
# it lives in state/ now, with the rest of what the bot mutates).
voice_settings.json

# Scratch answers written to the repo root by a session (whitelist-usernames.txt
# tables friends' Discord ids + usernames, and ends in a question to Tyler).
# Same privacy class as read_full*/stats.tsv above: real people, private servers.
whitelist-usernames.txt

# The guest-ideas sweep marker: bot-written progress state, same class as
# everything else in state/, but ".cursor" is matched by none of the rules above.
*.cursor

# Any .bak of bot state - repair_memory.py writes agent_memory.json.pre-repair.bak,
# which is Tyler's whole DM history. The *.jsonl.bak rule above did not cover it:
# ".json.pre-repair.bak" is neither *.jsonl nor *.jsonl.bak. Match the suffix itself.
*.bak

# Stage 3's conversation store: who was asked what, and what they answered. Real
# message content from real people, same class as agent_memory/guest_memory above.
# state/*.json is NOT ignored wholesale - each private file is listed by name, so
# a new one has to be added here deliberately. This is that.
conversations.json

# The batch-message pointer: counterparty id -> the Discord message currently
# showing them their queue, and which questions it shows. Bot-mutated state, and
# it names whose DM thread is whose - same class as conversations.json above.
# It shipped with the queue and had no rule, and two sessions found that
# independently, which is the tell: the file does not exist until someone is
# actually asked something, so an untouched state/ hides it from every check.
ask_batches.json

# The initiative lane: Claude's own open loops about Tyler, the questions it
# chose to ask him, and the reasoning behind every run that decided not to.
# Private in the same way agent_memory.json is - and the markdown log is the
# audit trail he reads, which is a local artifact by design.
initiative.json
initiative-log.md

# Rooms state (item 22). rooms.json and the per-caller read cursors are written
# by the bot at runtime - seq counters, worker session ids, "how far has cli read".
# They were committed during the rooms build and every session has shown them
# dirty since. Nothing depends on the committed copies: rooms._index() defaults
# to {"rooms": {}}, SCRATCH is ensure()d at boot, and the cursor dir is makedirs'd
# on write. The room CONTENT (state/rooms/*.jsonl) was already ignored by *.jsonl,
# so tracking its index was incoherent as well as noisy.
state/rooms.json
state/rooms/cursors/

# Guest outreach quiet timers: user id -> when they may be spoken to again.
# Bot-written, and it names which collaborator is muted and until when - same
# privacy class as conversations.json/ask_batches.json above.
state/guest_quiet.json

# One-off JSON dumps from a server build run (`--json` redirected to the repo
# root). Real category/channel ids for a real guild, and nothing reads the file -
# same class as the diag*.txt scratch output above.
build_out.json

# The pre-move snapshot marker Phase B writes beside a frozen state/ tree (2026-09-05).
# Machine-specific by nature: it says THIS tree moved, so it is never committed.
state/MOVED-*.md
# The initiates lane proof-of-run stamp (Phase B, INTENT 41) - written by the client on the PC.
state/initiative-heartbeat.local
