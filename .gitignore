*.env
webhooks.json
outbox/
channels.json
# Runtime transcripts and message logs. Catch-all rather than a per-file list, so
# a new *.jsonl cannot be committed by accident.
*.jsonl
bot.log
__pycache__/
*.pyc
venv-voice/
personality_overrides.txt
*.log
exaroton_watch.json
# Control plane: owner user ids + guild allowlists. Real IDs stay local; the
# committed control.json.example documents the shape.
control.json
# Agent conversation history — private message content.
agent_memory.json
# Guest conversations and their daily counters. Other people's message content and
# a record of who talked to Benham and how much; never commit either.
guest_memory.json
guest_usage.json

# Friend-server reads / derived social data — private, never commit
read_full*
*.u8
*.tsv
stats.tsv
# Bot stdout/stderr captures from Start-Process redirects (*.log is already covered,
# but the redirect targets do not always end in .log).
*.out
*.err
# Rotated-out captures. The patterns above already match inside it; this is here so
# the intent is obvious and nothing else in logs/ can sneak into a commit.
logs/
# Rotation writes `<name>.1`, which the extension patterns above do NOT match -
# "supervise.log.1" is not *.log and "inbox.jsonl.1" is not *.jsonl. Without these
# two lines the previous generation of every rotated file becomes committable, which
# is how private message content would reach the repo by the back door.
*.log.1
*.jsonl.1
# Attachments pulled off Discord by read_attachments. Other people's files, and
# bytes whoever uploaded them chose - neither belongs in the repo.
downloads/
# Throwaway diagnostic output from debugging sessions.
diag*.txt
d[0-9].txt
m[0-9].txt

# Guest workspace (guest-refactor Stage 4) - guests' files, never committed
guest_work/

# Manual backup of inbox.jsonl - same private message content as the original;
# .bak defeats both the *.jsonl and *.jsonl.1 patterns above.
*.jsonl.bak
# Task Scheduler exports embed the machine SID and account name - keep local.
*.task.backup.xml
# Claude session-local settings and worktrees.
.claude/

# Bot-written voice defaults (was mistakenly tracked until the src reorg;
# it lives in state/ now, with the rest of what the bot mutates).
voice_settings.json

# Scratch answers written to the repo root by a session (whitelist-usernames.txt
# tables friends' Discord ids + usernames, and ends in a question to Tyler).
# Same privacy class as read_full*/stats.tsv above: real people, private servers.
whitelist-usernames.txt
